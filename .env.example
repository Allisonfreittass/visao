# Copie para .env e preencha. Nunca versione o .env.
# Todas as chaves de apps/api/settings.py estão aqui, com o valor padrão do código.
# Linhas comentadas são opcionais e não aceitam valor vazio: descomente só para usar.
# O docker compose repassa este arquivo à API e ao worker (com o banco do compose).

# --- Ambiente e segurança ---
VISION_ENVIRONMENT=development
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VISION_SECRET_KEY=
VISION_ACCESS_TOKEN_TTL_MINUTES=60
VISION_LOG_LEVEL=INFO
# Senha do PostgreSQL do docker compose (não é lida pela aplicação).
POSTGRES_PASSWORD=

# --- Banco de dados ---
# SQLite local: o npm start aplica as migrações. Um postgresql+psycopg://... compartilhado
# só é migrado pelo deploy. No docker compose este valor é sobrescrito pelo banco do compose.
VISION_DATABASE_URL=sqlite:///./dev.db
# Esquema privado no PostgreSQL compartilhado (docs/CLOUDFLARE.md).
# VISION_DATABASE_SCHEMA=visao

# --- Nuvem e implantação (docs/CLOUDFLARE.md) ---
# Chave do tick agendado da nuvem, com 32+ caracteres.
# VISION_CLOUD_TICK_KEY=
# Preenchido pelo deploy com o commit publicado.
VISION_BUILD_SHA=local
# Propostas de código do próprio VISÃO (docs/CODE_EVOLUTION.md); a chave tem 32+ caracteres.
VISION_CODE_AUTONOMY_ENABLED=false
# VISION_CODE_AUTONOMY_KEY=

# --- LLM principal (qualquer endpoint compatível com OpenAI /chat/completions) ---
# Sem TODOS estes campos, inclusive os preços, a conversa fica desativada.
# Confira o nome exato do modelo e o preço vigente no painel do provedor.
VISION_LLM_PROVIDER_NAME=
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
# US$ por milhão de tokens, copiado da página de preços do provedor.
VISION_LLM_PRICE_INPUT_PER_MTOK=
VISION_LLM_PRICE_OUTPUT_PER_MTOK=
VISION_LLM_TIMEOUT_SECONDS=60
# Espaço para uma resposta completa; a brevidade vem do prompt, não do corte.
VISION_LLM_MAX_OUTPUT_TOKENS=2048
# Limite de saída da curadoria de memória (modelos que raciocinam gastam tokens pensando).
VISION_LLM_CURATION_MAX_OUTPUT_TOKENS=4096
# Só na conversa, para responder rápido (ex.: desligar o raciocínio interno do modelo). JSON.
VISION_LLM_FAST_EXTRA_BODY={}

# --- Reservas (usadas quando o principal esgota a cota, limita a taxa ou cai) ---
# Cada reserva só entra em uso com TODOS os campos preenchidos.
VISION_LLM_FALLBACK_PROVIDER_NAME=
VISION_LLM_FALLBACK_BASE_URL=
VISION_LLM_FALLBACK_API_KEY=
VISION_LLM_FALLBACK_MODEL=
VISION_LLM_FALLBACK_PRICE_INPUT_PER_MTOK=
VISION_LLM_FALLBACK_PRICE_OUTPUT_PER_MTOK=
VISION_LLM_FALLBACK_FAST_EXTRA_BODY={}
# Segunda reserva gratuita, opcional (ex.: Groq).
VISION_LLM_FALLBACK2_PROVIDER_NAME=
VISION_LLM_FALLBACK2_BASE_URL=
VISION_LLM_FALLBACK2_API_KEY=
VISION_LLM_FALLBACK2_MODEL=
VISION_LLM_FALLBACK2_PRICE_INPUT_PER_MTOK=
VISION_LLM_FALLBACK2_PRICE_OUTPUT_PER_MTOK=
VISION_LLM_FALLBACK2_FAST_EXTRA_BODY={}

# --- Custos e limites (docs/COSTS.md), aplicados no código antes de cada chamada ---
VISION_LLM_DAILY_BUDGET_USD=1.50
VISION_LLM_CONVERSATION_BUDGET_USD=0.30
# Gasto pago permitido: o código só aceita 0.
VISION_LLM_MAX_PAID_SPEND_USD=0
# Endpoints gratuitos revisados pelo operador: lista JSON com evidência e validade
# (docs/research/phase10_local_hardening.md). Vazia por padrão.
VISION_LLM_FREE_GRANTS=[]
# Uso local: aceita preço zero configurado; custo informado pelo provedor congela o razão.
# Provedor pago (ex.: Claude): só com os dois tetos acima de zero, em US$; o razão recusa a
# chamada que passaria deles. Zero = só provedores gratuitos.
VISION_LLM_PAID_DAILY_USD=0
VISION_LLM_PAID_MONTHLY_USD=0
VISION_LLM_TRUST_ZERO_PRICE=false
VISION_LLM_BUDGET_CALLS_PER_DAY=30
VISION_LLM_BUDGET_CALLS_PER_HOUR=10
VISION_LLM_BUDGET_INPUT_TOKENS_PER_DAY=60000
VISION_LLM_BUDGET_OUTPUT_TOKENS_PER_DAY=15000
# Medido em bytes: cabe o histórico (VISION_LLM_CONTEXT_CHAR_BUDGET) mais o prompt de sistema.
VISION_LLM_BUDGET_INPUT_TOKENS_PER_CALL=80000
VISION_LLM_BUDGET_OUTPUT_TOKENS_PER_CALL=4096
VISION_LLM_BUDGET_CONCURRENCY=1
# Teto aproximado do histórico enviado por chamada, em caracteres.
VISION_LLM_CONTEXT_CHAR_BUDGET=24000

# --- Voz (docs/VOICE.md) ---
# Ids de integrations/tts/catalog.py aprovados após ouvir. Vazio = sem voz.
VISION_TTS_APPROVED_VOICES=
VISION_TTS_MODELS_DIR=models/tts
VISION_TTS_MAX_CHARS=600
# Escuta: faster-whisper tiny|base|small (pip install -e '.[stt]'); vazio desliga.
VISION_STT_MODEL=
VISION_STT_MODELS_DIR=models/stt
# Cerca de 60 s de WAV mono 16 kHz; falas maiores são recusadas.
VISION_STT_MAX_BYTES=2000000

# --- Curiosidade e pesquisa (docs/CURIOSITY.md): +1 chamada ao LLM por turno ---
VISION_CURIOSITY_ENABLED=false
VISION_RESEARCH_PER_DAY=20
VISION_RESEARCH_PER_CONVERSATION=5
VISION_RESEARCH_MAX_RESULTS=3

# --- Ciclo autônomo do worker (docs/AUTONOMY.md) ---
# Orçamento só das ações sem mensagem; 0 chamadas desliga.
VISION_AUTONOMY_CYCLE_MINUTES=60
VISION_AUTONOMY_LLM_CALLS_PER_DAY=20
VISION_AUTONOMY_TOKENS_PER_DAY=60000
VISION_AUTONOMY_MAX_ACTIONS_PER_CYCLE=3
VISION_AUTONOMY_MAX_SECONDS=120

# --- Mente (docs/MIND.md): pensar entre conversas, estudar por interesse e puxar conversa ---
VISION_MIND_ENABLED=false
VISION_MIND_THINK_MINUTES=20
# Revisão da conversa a cada N turnos; correções disparam na hora.
VISION_MIND_REVIEW_TURNS=4
VISION_MIND_INITIATIVES_PER_DAY=6
VISION_STUDY_INTERVAL_MINUTES=360
# Web Push: leva a iniciativa ao celular com o app fechado. Desligado sem os três.
# Gere o par com: python -m apps.api.cli webpush-keys
VISION_WEBPUSH_PUBLIC_KEY=
VISION_WEBPUSH_PRIVATE_KEY=
# URL https do app ou contato mailto: (campo "sub" do VAPID).
VISION_WEBPUSH_SUBJECT=
