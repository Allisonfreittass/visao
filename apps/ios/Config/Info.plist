<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>VisaoAPIBaseURL</key>
	<string>$(VISAO_API_BASE_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
		<string>InterTight-Regular.ttf</string>
		<string>InterTight-Medium.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>JetBrainsMono-Medium.ttf</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>VisaoLiveActivityPush</key>
	<string>$(VISAO_LIVE_ACTIVITY_PUSH)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Para você conversar com ele por voz numa ligação. Nada escuta com o app fechado.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Para entender o que você fala na ligação. Quando o iPhone permite, o reconhecimento roda no próprio aparelho.</string>
	<key>NSCameraUsageDescription</key>
	<string>Para tirar uma foto e mandar na conversa.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
