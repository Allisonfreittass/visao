{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visao",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 10000 },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"]
  },
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "91827461", "simple": { "limit": 8, "period": 60 } }],
  "triggers": { "crons": [] },
  "containers": [{
    "class_name": "VisaoBackend",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "../../Dockerfile" } }
  }],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "VisaoBackend" }],
    "code_update_strategy": { "mode": "deferred", "max_delay": 30 }
  },
  "exports": { "VisaoBackend": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "VISION_ENVIRONMENT": "production",
    "VISION_CODE_AUTONOMY_ENABLED": "true",
    "VISION_DATABASE_SCHEMA": "visao",
    "VISION_LOG_LEVEL": "INFO",
    "VISION_LLM_MAX_PAID_SPEND_USD": "0",
    "VISION_LLM_TRUST_ZERO_PRICE": "true",
    "VISION_LLM_BUDGET_CALLS_PER_DAY": "300",
    "VISION_LLM_BUDGET_CALLS_PER_HOUR": "40",
    "VISION_LLM_BUDGET_INPUT_TOKENS_PER_DAY": "8000000",
    "VISION_LLM_BUDGET_OUTPUT_TOKENS_PER_DAY": "1500000",
    "VISION_LLM_BUDGET_CONCURRENCY": "4",
    "VISION_LLM_FAST_EXTRA_BODY": "{\"reasoning\":{\"enabled\":false}}",
    "VISION_LLM_FALLBACK_FAST_EXTRA_BODY": "{\"chat_template_kwargs\":{\"enable_thinking\":false}}",
    "VISION_MIND_ENABLED": "false",
    "VISION_MIND_THINK_MINUTES": "30",
    "VISION_MIND_REVIEW_TURNS": "4",
    "VISION_MIND_INITIATIVES_PER_DAY": "6",
    "VISION_STUDY_INTERVAL_MINUTES": "360",
    "VISION_LLM_FREE_GRANTS": "[{\"provider\":\"openrouter\",\"endpoint\":\"https://openrouter.ai/api/v1\",\"model\":\"nvidia/nemotron-3.5-super-vl:free\",\"evidence_url\":\"https://openrouter.ai/docs/guides/routing/model-variants/free\",\"verified_at\":\"2026-11-01T19:48:16Z\",\"expires_at\":\"2026-11-08T19:48:16Z\",\"prices\":{\"platform\":\"0\",\"tools\":\"0\",\"audio\":\"0\",\"cache\":\"0\",\"routing\":\"0\",\"input\":\"0\",\"output\":\"0\"}}]",
    "VISION_CURIOSITY_ENABLED": "true",
    "VISION_AUTONOMY_CYCLE_MINUTES": "60",
    "VISION_AUTONOMY_MAX_SECONDS": "180",
    "VISION_AUTONOMY_LLM_CALLS_PER_DAY": "200",
    "VISION_AUTONOMY_TOKENS_PER_DAY": "1500000",
    "VISION_AUTONOMY_MAX_ACTIONS_PER_CYCLE": "3",
    "VISION_TTS_APPROVED_VOICES": "",
    "VISION_STT_MODEL": ""
  }
}
