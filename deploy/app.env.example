# /etc/visao/app.env no servidor (dono root, leitura do grupo deploy; nunca no Git).
# Editar: sudo nano /etc/visao/app.env, depois: cd /opt/visao && docker compose up -d
# Todos os campos estão em .env.example; aqui só o que a produção precisa.
VISION_ENVIRONMENT=production
# Nova, com: python3 -c "import secrets; print(secrets.token_urlsafe(48))". Trocar só obriga a
# entrar de novo (ela assina os logins; senhas não dependem dela).
VISION_SECRET_KEY=
VISION_ACCESS_TOKEN_TTL_MINUTES=1440
# O mesmo banco da nuvem (Supabase), com o login dedicado ao backend e o schema privado.
VISION_DATABASE_URL=postgresql+psycopg://...
VISION_DATABASE_SCHEMA=visao
VISION_LOG_LEVEL=INFO

# Modelo de linguagem: Claude Haiku 5.5 pela API da Anthropic (a chave vem do console.anthropic.com).
VISION_LLM_PROVIDER_NAME=anthropic
VISION_LLM_BASE_URL=https://api.anthropic.com
VISION_LLM_API_KEY=
VISION_LLM_MODEL=claude-haiku-5-5
# Preços oficiais, US$ por milhão de tokens (até 100 mil tokens de entrada por chamada).
VISION_LLM_PRICE_INPUT_PER_MTOK=0.10
VISION_LLM_PRICE_OUTPUT_PER_MTOK=0.50
# Tetos em US$: o razão recusa a chamada que passaria deles. Com zero, nenhum provedor pago entra.
VISION_LLM_PAID_DAILY_USD=0.50
VISION_LLM_PAID_MONTHLY_USD=10
VISION_LLM_TRUST_ZERO_PRICE=false
# A conversa responde sem raciocínio interno (mais rápida); o trabalho de fundo pensa pouco.
VISION_LLM_FAST_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Reserva opcional (ex.: Groq gratuito); preencha todas ou nenhuma.
VISION_LLM_FALLBACK_PROVIDER_NAME=
VISION_LLM_FALLBACK_BASE_URL=
VISION_LLM_FALLBACK_API_KEY=
VISION_LLM_FALLBACK_MODEL=
VISION_LLM_FALLBACK_PRICE_INPUT_PER_MTOK=
VISION_LLM_FALLBACK_PRICE_OUTPUT_PER_MTOK=
VISION_LLM_BUDGET_CALLS_PER_DAY=300
VISION_LLM_BUDGET_CALLS_PER_HOUR=40
VISION_LLM_BUDGET_INPUT_TOKENS_PER_DAY=8000000
VISION_LLM_BUDGET_OUTPUT_TOKENS_PER_DAY=1500000
VISION_LLM_BUDGET_CONCURRENCY=4

# Mente e autonomia: aqui o worker roda 24 h, então ele pensa e puxa conversa sem o Mac.
VISION_MIND_ENABLED=true
VISION_MIND_THINK_MINUTES=30
VISION_MIND_INITIATIVES_PER_DAY=6
VISION_STUDY_INTERVAL_MINUTES=360
VISION_CURIOSITY_ENABLED=true
VISION_AUTONOMY_CYCLE_MINUTES=60
VISION_AUTONOMY_MAX_SECONDS=180
VISION_AUTONOMY_LLM_CALLS_PER_DAY=200
VISION_AUTONOMY_TOKENS_PER_DAY=1500000

# Avisos com o app fechado: as chaves de ~/.config/visao/vapid-producao.env.
VISION_WEBPUSH_PUBLIC_KEY=
VISION_WEBPUSH_PRIVATE_KEY=
VISION_WEBPUSH_SUBJECT=https://SEU-DOMINIO
# Opcional: token do GitHub só de leitura (Contents: read). Abre os seus repositórios privados
# quando você manda o link de um, e sobe o limite de 60 para 5000 leituras por hora.
VISION_GITHUB_TOKEN=
# Opcional: busca na web na conversa pelo Tavily (tavily.com, plano grátis de 1000 buscas/mês).
# Sem ela, a pesquisa da conversa usa Wikipédia e arXiv.
VISION_TAVILY_API_KEY=

# Evolução de código (docs/CODE_EVOLUTION.md): só se o experimento continuar.
VISION_CODE_AUTONOMY_ENABLED=false
# VISION_CODE_AUTONOMY_KEY=
