# HTTPS automático (Let's Encrypt) para o domínio em /etc/visao/caddy.env (VISAO_DOMAIN).
{$VISAO_DOMAIN} {
	encode zstd gzip

	# Rotas internas nunca ficam expostas (a nuvem antiga também as bloqueava).
	# Em `handle` próprio: um `respond` solto rodaria só depois dos blocos abaixo.
	@internal path /internal /internal/* /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	handle_path /api/* {
		request_body {
			max_size 16MB
		}
		reverse_proxy api:8000 {
			# Sem a Cloudflare na frente, esse cabeçalho viria do próprio visitante: tira.
			header_up -Cf-Connecting-Ip
		}
	}

	handle {
		root * /srv/releases/current
		# Arquivos com hash no nome nunca mudam; o service worker e a página, sempre frescos.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path / /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# "?" só preenche quando a resposta não trouxe: as páginas (/api/p/...) mandam no-referrer.
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
